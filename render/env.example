# SkinIntel backend Render environment variables
# Copy these values into Render's Environment settings.

MODEL_PATH=models/model.keras
CONCERN_MODEL_PATH=models/model.keras
PRODUCTS_CSV_PATH=data/skincare_products_clean.csv
MODEL_VERSION=1.0.0
ALLOWED_ORIGIN=https://your-frontend.onrender.com
MAX_IMAGE_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=30
CONFIDENCE_THRESHOLD=0.40
JWT_EXPIRY_HOURS=24
JWT_SECRET=replace-with-a-long-random-secret
AWS_REGION=ap-south-1
DYNAMODB_TABLE=skinintel_users
DYNAMODB_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=